{
  "name": "@piligrimnick/codex-agent",
  "version": "0.1.1",
  "description": "Autosk agent backed by Codex CLI headless mode (codex exec --json).",
  "license": "MIT",
  "author": "piligrimnick",
  "homepage": "https://github.com/piligrimnick/codex-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piligrimnick/codex-agent.git"
  },
  "bugs": {
    "url": "https://github.com/piligrimnick/codex-agent/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts"
  },
  "types": "./index.ts",
  "autosk": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "autosk",
    "autosk-extension",
    "autosk-agent",
    "codex"
  ],
  "dependencies": {
    "@autosk/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
